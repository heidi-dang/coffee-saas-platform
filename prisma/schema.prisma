generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  CAFE_OWNER
  CAFE_MANAGER
  CAFE_STAFF
}

enum OptionType {
  SINGLE
  MULTIPLE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  PICKUP
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(CAFE_STAFF)
  cafeId       String?
  cafe         Cafe?     @relation(fields: [cafeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Cafe {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  currency  String          @default("AUD")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  categories MenuCategory[]
  items     MenuItem[]
  tables    CafeTable[]
  orders    Order[]
  settings  CafeSettings?
  theme     CafeTheme?
  sections  CafePageSection[]
}

model CafeSettings {
  id                  String   @id @default(cuid())
  cafeId              String   @unique
  cafe                Cafe     @relation(fields: [cafeId], references: [id])
  acceptDineIn        Boolean  @default(true)
  acceptTakeaway      Boolean  @default(true)
  acceptPickup        Boolean  @default(true)
  acceptPayAtCounter  Boolean  @default(true)
  acceptOnlinePayment Boolean  @default(false)
  openingHoursJson    Json?
}

model MenuCategory {
  id        String     @id @default(cuid())
  cafeId    String
  cafe      Cafe       @relation(fields: [cafeId], references: [id])
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]

  @@index([cafeId, sortOrder])
  @@index([cafeId, isActive])
}

model MenuItem {
  id          String           @id @default(cuid())
  cafeId      String
  cafe        Cafe             @relation(fields: [cafeId], references: [id])
  categoryId  String
  category    MenuCategory     @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  imageUrl    String?
  priceCents  Int
  isAvailable Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  options     MenuItemOption[]

  @@index([cafeId, categoryId])
  @@index([cafeId, isAvailable])
  @@index([categoryId, sortOrder])
}

model MenuItemOption {
  id        String                @id @default(cuid())
  menuItemId String
  menuItem  MenuItem              @relation(fields: [menuItemId], references: [id])
  name      String
  type      OptionType
  required  Boolean               @default(false)
  minSelect Int                   @default(0)
  maxSelect Int                   @default(1)
  values    MenuItemOptionValue[]
}

model MenuItemOptionValue {
  id        String         @id @default(cuid())
  optionId  String
  option    MenuItemOption @relation(fields: [optionId], references: [id])
  name      String
  priceCents Int           @default(0)
  sortOrder  Int           @default(0)
}

model CafeTable {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id])
  tableNumber String
  qrToken     String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]

  @@unique([cafeId, tableNumber])
  @@index([cafeId, isActive])
}

model Order {
  id              String       @id @default(cuid())
  cafeId          String
  cafe            Cafe         @relation(fields: [cafeId], references: [id])
  orderNumber     Int
  type            OrderType
  status          OrderStatus  @default(NEW)
  paymentStatus   PaymentStatus @default(UNPAID)
  tableId         String?
  table           CafeTable?   @relation(fields: [tableId], references: [id])
  customerName    String?
  customerPhone   String?
  customerNote    String?
  subtotalCents   Int
  totalCents      Int
  stripeSessionId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]

  @@unique([cafeId, orderNumber])
  @@index([cafeId, status])
  @@index([cafeId, createdAt])
  @@index([tableId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  menuItemId      String
  itemNameSnapshot String
  quantity        Int
  unitPriceCents  Int
  totalCents      Int
  optionsSnapshot Json?
  notes           String?
}

enum PageSectionType {
  HERO
  ABOUT
  FEATURED_MENU
  GALLERY
  ANNOUNCEMENT
  CONTACT
  CUSTOM_TEXT
}

enum PageSectionStatus {
  DRAFT
  PUBLISHED
}

model CafeTheme {
  id              String   @id @default(cuid())
  cafeId          String   @unique
  cafe            Cafe     @relation(fields: [cafeId], references: [id])
  primaryColor    String   @default("#111827")
  accentColor     String   @default("#f59e0b")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#111827")
  logoUrl         String?
  heroImageUrl    String?
  fontFamily      String   @default("system")
  draftData       Json?
  publishedData   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cafeId])
}

model CafePageSection {
  id        String            @id @default(cuid())
  cafeId    String
  cafe      Cafe              @relation(fields: [cafeId], references: [id])
  type      PageSectionType
  title     String?
  content   Json
  sortOrder Int               @default(0)
  isVisible Boolean           @default(true)
  status    PageSectionStatus @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([cafeId, status])
  @@index([cafeId, sortOrder])
}
