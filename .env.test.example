# Coffee SaaS Test Environment
# Copy to .env.test and fill in real values.
# Never commit .env.test or secrets.

NODE_ENV=production
APP_ENV=test

# The public URL of the test deployment
NEXT_PUBLIC_APP_URL=https://coffee-test.example.com

# Port the Next.js test server listens on
# Must NOT be 80 or 443 (Caddy owns those)
TEST_APP_PORT=3100

# PostgreSQL connection string for the TEST database
# Must be a separate database, NOT the production database
DATABASE_URL=postgresql://coffee_user:coffee_password@localhost:5432/coffee_saas_platform_test

# JWT signing secret — must be at least 32 characters
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars

# Stripe (Week 5) — leave blank to disable online payments
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
